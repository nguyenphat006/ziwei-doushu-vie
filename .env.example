# 复制为 .env.local 后填入实际值

# ─── AI 解读（/api/interpret，OpenAI 兼容协议，任选一家）───
# 只想排盘、看命盘的话不用填。配置多家时用 AI_PROVIDER=gemini|deepseek|custom 指定。

# Google Gemini（AI Studio 有免费额度：https://aistudio.google.com/apikey）
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# 其他 OpenAI 兼容服务
# AI_BASE_URL=https://your-provider/v1
# AI_API_KEY=
# AI_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
